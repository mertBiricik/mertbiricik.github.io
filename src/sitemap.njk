---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
layout: null
---<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for page in collections.all %}
  {%- if not page.data.eleventyExcludeFromCollections %}
  <url>
    <loc>{{ metadata.url }}{{ page.url | url }}</loc>
    {%- if page.data.date %}
    <lastmod>{{ page.date | dateISO }}</lastmod>
    {%- endif %}
    <priority>{{ page.data.priority or 0.5 }}</priority>
    <changefreq>{{ page.data.changefreq or 'monthly' }}</changefreq>
  </url>
  {%- endif %}
{%- endfor %}
</urlset>
