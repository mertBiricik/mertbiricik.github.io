---
layout: base
title: Blog
description: Longer write-ups of things I worked on.
priority: 0.7
changefreq: monthly
---

<section class="container-wide pt-16 sm:pt-20 pb-10">
  <div class="max-w-3xl">
    <p class="meta-label">Blog</p>
    <h1 class="display-2 mt-5">Notes</h1>
    <p class="mt-6 font-sans text-xl text-slate-500 leading-relaxed">
      Longer write-ups of things I worked on: security, infrastructure, data and sometimes music.
    </p>
  </div>
</section>

<section class="container-wide pb-24">
  <ol class="border-t border-slate-200">
    {% for post in collections.blog | reverse %}
    <article class="grid md:grid-cols-12 gap-6 py-10 border-b border-slate-200">
      <div class="md:col-span-3">
        <p class="font-sans text-sm text-slate-500">{{ post.date | dateFormat }}</p>
      </div>
      <div class="md:col-span-9">
        <h2 class="font-display text-2xl sm:text-3xl font-semibold leading-tight text-slate-900">
          <a href="{{ post.url }}" class="no-underline hover:text-primary-600">{{ post.data.title }}</a>
        </h2>
        {% if post.data.description %}
        <p class="mt-3 font-sans text-base sm:text-lg text-slate-600 leading-relaxed">{{ post.data.description }}</p>
        {% endif %}
        {% if post.data.tags %}
        <ul class="mt-5 flex flex-wrap gap-2">
          {% for tag in post.data.tags %}<li class="meta-label">{{ tag }}</li>{% endfor %}
        </ul>
        {% endif %}
      </div>
    </article>
    {% endfor %}
  </ol>

  {% if not collections.blog.length %}
  <p class="py-16 text-center font-sans text-slate-500">No posts yet.</p>
  {% endif %}
</section>
