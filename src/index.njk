---
layout: base
title: false
priority: 1.0
changefreq: weekly
---

{# ============= HERO ============= #}
<section class="container-wide pt-32 pb-24">
  <div class="grid lg:grid-cols-12 gap-12 items-center">
    <div class="lg:col-span-8 lg:pr-12">
      <p class="text-sm font-semibold uppercase tracking-widest text-sage-600 dark:text-sage-400 mb-6">{{ home.hero.eyebrow }}</p>

      <h1 class="display-1 text-slate-900 dark:text-white text-balance mb-8">
        {{ home.hero.title }}
      </h1>

      <p class="font-sans text-lg sm:text-xl leading-relaxed text-slate-600 dark:text-slate-300 max-w-3xl mb-10 text-justify">
        {{ home.hero.valueProposition }}
      </p>

      <div class="flex flex-wrap gap-4">
        <a href="{{ home.hero.ctaPrimary.url }}" class="btn-primary">
          {{ home.hero.ctaPrimary.label }}
        </a>
        <a href="{{ home.hero.ctaSecondary.url }}" class="btn-secondary">
          {{ home.hero.ctaSecondary.label }}
        </a>
      </div>
    </div>
  </div>
</section>

{# ============= PHILOSOPHY ============= #}
<section class="bg-sage-50/50 dark:bg-slate-800/20 border-y border-slate-200 dark:border-slate-800">
  <div class="container-wide section">
    <div class="max-w-4xl mx-auto text-center mb-16">
      <h2 class="display-2 text-slate-900 dark:text-white">{{ home.philosophy.title }}</h2>
    </div>
    
    <div class="max-w-3xl mx-auto space-y-8 font-sans text-lg text-slate-600 dark:text-slate-300 leading-relaxed text-justify">
      {% for p in home.philosophy.content %}
      <p>{{ p }}</p>
      {% endfor %}
    </div>
  </div>
</section>

{# ============= MEDIA & PUBLICATIONS ============= #}
<section class="container-wide section">
  <div class="flex items-center gap-6 mb-16">
    <h2 class="display-2 text-slate-900 dark:text-white">{{ home.media.title }}</h2>
    <div class="flex-1 h-px bg-slate-200 dark:bg-slate-800"></div>
  </div>

  <div class="grid md:grid-cols-2 gap-8">
    {% for item in home.media.items %}
    <div class="glass-card p-8 group">
      {% if item.type == 'publication' %}
        <span class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-slate-500 mb-4">
          <i class="fa-solid fa-file-lines text-sage-500"></i> Publication
        </span>
        <h3 class="font-display text-2xl font-semibold text-slate-900 dark:text-white mb-3">{{ item.title }}</h3>
        <p class="text-sm font-medium text-sage-600 dark:text-sage-400 mb-4">{{ item.publisher }}</p>
        <p class="font-sans text-slate-600 dark:text-slate-400 leading-relaxed text-justify">{{ item.summary }}</p>
        {% if item.link and item.link != '#' %}
        <a href="{{ item.link }}" class="inline-flex items-center gap-2 mt-6 text-sm font-semibold text-slate-900 dark:text-white hover:text-sage-600 dark:hover:text-sage-400">
          Read Paper <i class="fa-solid fa-arrow-right"></i>
        </a>
        {% endif %}
      {% elif item.type == 'video' %}
        <span class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-slate-500 mb-4">
          <i class="fa-solid fa-video text-sage-500"></i> Media
        </span>
        <h3 class="font-display text-2xl font-semibold text-slate-900 dark:text-white mb-4">{{ item.title }}</h3>
        <div class="aspect-video bg-slate-200 dark:bg-slate-800 rounded-lg flex items-center justify-center mb-6 border border-slate-300 dark:border-slate-700">
          <span class="text-sm text-slate-500">[ Video Placeholder: {{ item.videoId }} ]</span>
        </div>
        <details class="group/details">
          <summary class="cursor-pointer font-medium text-slate-900 dark:text-white flex items-center justify-between border-t border-slate-200 dark:border-slate-700 pt-4">
            Executive Summary
            <i class="fa-solid fa-chevron-down transition-transform group-open/details:rotate-180"></i>
          </summary>
          <div class="pt-4 font-sans text-slate-600 dark:text-slate-400 leading-relaxed text-justify">
            {{ item.executiveSummary }}
          </div>
        </details>
      {% endif %}
    </div>
    {% endfor %}
  </div>
</section>

{# ============= TIMELINE / CV ============= #}
<section class="bg-slate-50 dark:bg-slate-900 border-y border-slate-200 dark:border-slate-800">
  <div class="container-wide section">
    <div class="max-w-4xl mx-auto">
      <h2 class="display-2 text-slate-900 dark:text-white text-center mb-16">Experience & Education</h2>
      
      <div class="relative border-l-2 border-slate-200 dark:border-slate-800 ml-3 md:ml-6 space-y-12">
        {% for entry in home.timeline %}
        <div class="relative pl-8 md:pl-12 group">
          <span class="absolute -left-[9px] top-1.5 h-4 w-4 rounded-full bg-white dark:bg-slate-900 border-2 border-sage-500 transition-colors group-hover:bg-sage-500"></span>
          
          <div class="flex flex-col md:flex-row md:items-baseline gap-2 md:gap-4 mb-3">
            <h3 class="font-display text-xl font-semibold text-slate-900 dark:text-white">{{ entry.role }}</h3>
            <span class="text-sm font-mono text-sage-600 dark:text-sage-400">{{ entry.period }}</span>
          </div>
          
          <p class="text-sm font-medium text-slate-500 dark:text-slate-400 mb-3">{{ entry.organization }}</p>
          <p class="font-sans text-slate-600 dark:text-slate-300 leading-relaxed text-justify max-w-2xl">
            {{ entry.description }}
          </p>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{# ============= CONTACT ============= #}
<section class="container-wide section text-center">
  <div class="max-w-3xl mx-auto">
    <p class="text-sm font-semibold uppercase tracking-widest text-sage-600 dark:text-sage-400 mb-6">Contact</p>
    <h2 class="display-2 text-slate-900 dark:text-white mb-6">{{ home.contact.title }}</h2>
    <p class="font-sans text-lg text-slate-600 dark:text-slate-400 mb-12">
      {{ home.contact.description }}
    </p>

    <div class="grid sm:grid-cols-2 gap-6 max-w-2xl mx-auto mb-16 text-left">
      <div class="glass-card p-6 flex items-start gap-4">
        <div class="h-10 w-10 rounded-full bg-sage-100 dark:bg-slate-800 flex items-center justify-center text-sage-600 dark:text-sage-400 shrink-0">
          <i class="fa-regular fa-envelope"></i>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-1">Email</p>
          <a href="mailto:{{ home.contact.email }}" class="font-medium text-slate-900 dark:text-white hover:text-sage-600">{{ home.contact.email }}</a>
        </div>
      </div>
      <div class="glass-card p-6 flex items-start gap-4">
        <div class="h-10 w-10 rounded-full bg-sage-100 dark:bg-slate-800 flex items-center justify-center text-sage-600 dark:text-sage-400 shrink-0">
          <i class="fa-solid fa-location-dot"></i>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-1">Location</p>
          <p class="font-medium text-slate-900 dark:text-white">{{ home.contact.address }}</p>
          <p class="text-sm text-slate-500 mt-1">{{ home.contact.workingHours }}</p>
        </div>
      </div>
    </div>
    
    <div class="aspect-[21/9] w-full bg-slate-200 dark:bg-slate-800 rounded-2xl overflow-hidden border border-slate-300 dark:border-slate-700 flex items-center justify-center relative group">
      <span class="text-sm text-slate-500">[ Google Maps Embed Placeholder ]</span>
    </div>
  </div>
</section>
