---
layout: base
title: false
priority: 1.0
changefreq: weekly
---

{# ============= HERO ============= #}
<section class="container-wide pt-32 pb-24 relative overflow-hidden">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-cyber-900/40 via-void-900 to-void-900 -z-10 pointer-events-none"></div>
  <div class="grid lg:grid-cols-12 gap-12 items-center">
    <div class="lg:col-span-8 lg:pr-12">
      <p class="terminal-text mb-6 before:content-['>_'] before:mr-2 before:text-void-400">{{ home.hero.eyebrow }}</p>

      <h1 class="display-1 text-balance mb-8 drop-shadow-[0_0_15px_rgba(0,196,212,0.15)]">
        {{ home.hero.title }}
      </h1>

      <p class="font-sans text-lg sm:text-xl leading-relaxed text-void-300 max-w-3xl mb-10 text-justify">
        {{ home.hero.valueProposition }}
      </p>

      <div class="flex flex-wrap gap-4">
        <a href="{{ home.hero.ctaPrimary.url }}" class="btn-primary">
          {{ home.hero.ctaPrimary.label }}
        </a>
        <a href="{{ home.hero.ctaSecondary.url }}" class="btn-secondary">
          {{ home.hero.ctaSecondary.label }}
        </a>
      </div>
    </div>
  </div>
</section>

{# ============= PHILOSOPHY ============= #}
<section class="bg-void-800/50 border-y border-void-700 relative">
  <div class="absolute inset-y-0 left-0 w-1 bg-cyber-500/20"></div>
  <div class="container-wide section">
    <div class="max-w-4xl mx-auto text-center mb-16">
      <p class="terminal-text mb-2">SYSTEM.CORE</p>
      <h2 class="display-2">{{ home.philosophy.title }}</h2>
    </div>
    
    <div class="max-w-3xl mx-auto space-y-8 font-sans text-lg text-void-300 leading-relaxed text-justify relative">
      <div class="absolute -left-6 md:-left-12 top-0 bottom-0 border-l border-dashed border-void-600 hidden sm:block"></div>
      {% for p in home.philosophy.content %}
      <p class="relative">
        <span class="absolute -left-8 md:-left-14 top-2.5 w-4 h-[1px] bg-cyber-500/50 hidden sm:block"></span>
        {{ p }}
      </p>
      {% endfor %}
    </div>
  </div>
</section>

{# ============= STACK / SKILLS ============= #}
<section class="container-wide section">
  <div class="flex items-center gap-6 mb-16">
    <h2 class="display-2">Threat Vectors & Stack</h2>
    <div class="flex-1 h-px bg-void-700 relative overflow-hidden"></div>
  </div>

  <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
    {% for group in profile.skills %}
    <div class="cyber-card p-6 flex flex-col group">
      <div class="flex items-center justify-between mb-6">
        <div class="h-10 w-10 bg-void-900 border border-cyber-500/30 flex items-center justify-center text-cyber-500 shadow-[inset_0_0_10px_rgba(0,196,212,0.1)] group-hover:bg-cyber-500 group-hover:text-void-900 transition-colors">
          <i class="fa-solid {{ group.icon | default('fa-microchip') }}"></i>
        </div>
        <span class="font-mono text-[10px] text-void-500">{{ group.items | length }} items</span>
      </div>
      <h3 class="font-display text-lg font-semibold text-void-50 mb-4">{{ group.group }}</h3>
      <ul class="flex flex-wrap gap-2 mt-auto">
        {% for item in group.items %}
        <li class="font-mono text-[10px] uppercase tracking-widest bg-void-900 text-cyber-400 border border-void-700 px-2 py-1 rounded group-hover:border-cyber-500/30 transition-colors">{{ item }}</li>
        {% endfor %}
      </ul>
    </div>
    {% endfor %}
  </div>
</section>

{# ============= FEATURED PROJECTS ============= #}
<section class="bg-void-800/30 border-y border-void-700">
  <div class="container-wide section">
    <div class="flex items-center gap-6 mb-16">
      <div class="flex-1 h-px bg-void-700 relative overflow-hidden hidden md:block"></div>
      <h2 class="display-2">Deployed Architectures</h2>
      <div class="flex-1 h-px bg-void-700 relative overflow-hidden">
        <div class="absolute right-0 top-0 h-full w-24 bg-gradient-to-l from-transparent via-cyber-500/50 to-transparent animate-[pulse_3s_ease-in-out_infinite]"></div>
      </div>
    </div>

    <div class="space-y-8">
      {% for project in projects.featured %}
      <article class="cyber-card p-8 grid lg:grid-cols-12 gap-8 items-start group">
        <div class="lg:col-span-8">
          <div class="flex items-center gap-3 mb-4">
            <span class="terminal-text !text-alert-500">OP_{{ loop.index | pad(2) }}</span>
            <span class="text-void-600">/</span>
            <span class="font-mono text-xs text-void-400">{{ project.period }}</span>
          </div>
          <h3 class="font-display text-3xl font-semibold text-void-50 mb-2 group-hover:text-cyber-300 transition-colors">{{ project.title }}</h3>
          <p class="font-mono text-sm text-cyber-500 mb-6">> {{ project.subtitle }}</p>
          
          <div class="space-y-4 font-sans text-void-300 leading-relaxed text-justify">
            <p><strong class="text-void-50 font-medium">Problem:</strong> {{ project.problem }}</p>
            <p><strong class="text-void-50 font-medium">Approach:</strong> {{ project.solution }}</p>
            <p><strong class="text-void-50 font-medium">Result:</strong> <span class="text-cyber-400">{{ project.outcome }}</span></p>
          </div>
        </div>

        <div class="lg:col-span-4 lg:pl-8 lg:border-l lg:border-void-700 h-full flex flex-col">
          <p class="terminal-text mb-4">TECHNOLOGY_STACK</p>
          <ul class="flex flex-wrap gap-2 mb-8">
            {% for t in project.tech %}
            <li class="font-mono text-[10px] uppercase tracking-widest bg-void-900 text-void-300 border border-void-600 px-2 py-1 rounded">{{ t }}</li>
            {% endfor %}
          </ul>

          <div class="mt-auto space-y-3 font-mono text-[11px] uppercase tracking-[0.18em]">
            {% if project.sourceLink %}
            <a href="{{ project.sourceLink }}" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-void-400 hover:text-cyber-400 !border-none group/link">
              <i class="fa-brands fa-github"></i> Source Code <i class="fa-solid fa-arrow-right opacity-0 group-hover/link:opacity-100 transition-opacity ml-auto"></i>
            </a>
            {% endif %}
            {% if project.visitSiteLink %}
            <a href="{{ project.visitSiteLink }}" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-void-400 hover:text-cyber-400 !border-none group/link">
              <i class="fa-solid fa-globe"></i> Live System <i class="fa-solid fa-arrow-right opacity-0 group-hover/link:opacity-100 transition-opacity ml-auto"></i>
            </a>
            {% endif %}
            {% if project.demoLink %}
            <a href="{{ project.demoLink }}" class="flex items-center gap-2 text-void-400 hover:text-cyber-400 !border-none group/link">
              <i class="fa-solid fa-display"></i> Embedded Demo <i class="fa-solid fa-arrow-right opacity-0 group-hover/link:opacity-100 transition-opacity ml-auto"></i>
            </a>
            {% endif %}
          </div>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{# ============= RECENT PUBLICATIONS ============= #}
<section class="container-wide section">
  <div class="flex items-center gap-6 mb-16">
    <h2 class="display-2">Academic Telemetry</h2>
    <div class="flex-1 h-px bg-void-700 relative overflow-hidden"></div>
  </div>

  <div class="grid gap-6">
    {% for pub in publications.slice(0, 4) %}
    <div class="cyber-card p-6 md:p-8 flex flex-col md:flex-row gap-6 md:gap-8 items-start group">
      <div class="shrink-0 font-mono text-xl font-bold text-void-700 group-hover:text-cyber-500/30 transition-colors">
        {{ pub.year }}
      </div>
      <div class="flex-1">
        <div class="flex flex-wrap items-center gap-3 mb-2">
          {% if pub.status == 'published' %}<span class="px-2 py-0.5 rounded bg-cyber-500/10 text-cyber-500 border border-cyber-500/30 font-mono text-[10px] uppercase tracking-widest">Published</span>
          {% elif pub.status == 'under-review' %}<span class="px-2 py-0.5 rounded bg-alert-500/10 text-alert-500 border border-alert-500/30 font-mono text-[10px] uppercase tracking-widest">Under Review</span>
          {% else %}<span class="px-2 py-0.5 rounded bg-void-800 text-void-400 border border-void-600 font-mono text-[10px] uppercase tracking-widest">{{ pub.status | replace("-", " ") }}</span>
          {% endif %}
          <span class="font-mono text-[11px] text-void-400">{{ pub.venue }}</span>
        </div>
        <h3 class="font-display text-xl font-semibold text-void-50 mb-3 group-hover:text-cyber-300 transition-colors">
          {% if pub.link %}<a href="{{ pub.link }}" target="_blank" rel="noopener noreferrer" class="!border-none">{{ pub.title }}</a>{% else %}{{ pub.title }}{% endif %}
        </h3>
        <p class="font-sans text-sm text-void-400 mb-4">{{ pub.authors | join(', ') }}</p>
        <p class="font-sans text-void-300 leading-relaxed text-justify">{{ pub.summary }}</p>
      </div>
    </div>
    {% endfor %}
  </div>
</section>

{# ============= TIMELINE / CV ============= #}
<section class="bg-void-800/30 border-y border-void-700">
  <div class="container-wide section">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-16">
        <p class="terminal-text mb-2">OPERATIONAL_HISTORY</p>
        <h2 class="display-2">Experience & Education</h2>
      </div>
      
      <div class="relative border-l border-void-600 ml-3 md:ml-6 space-y-12 py-4">
        {% for entry in home.timeline %}
        <div class="relative pl-8 md:pl-12 group">
          <span class="absolute -left-[5px] top-2 h-2.5 w-2.5 rounded-sm bg-void-900 border border-cyber-500 transition-all duration-300 group-hover:bg-cyber-500 group-hover:shadow-[0_0_10px_rgba(0,196,212,0.8)]"></span>
          <span class="absolute left-0 top-[11px] h-px w-6 md:w-10 bg-void-600 group-hover:bg-cyber-500/50 transition-colors"></span>
          
          <div class="flex flex-col md:flex-row md:items-baseline gap-2 md:gap-4 mb-2">
            <h3 class="font-display text-xl font-semibold text-void-50 drop-shadow-sm">{{ entry.role }}</h3>
            <span class="terminal-text !text-void-400 group-hover:!text-cyber-400 transition-colors">{{ entry.period }}</span>
          </div>
          
          <p class="font-mono text-sm text-cyber-500 mb-3">> {{ entry.organization }}</p>
          <p class="font-sans text-void-300 leading-relaxed text-justify max-w-2xl bg-void-900/50 p-4 rounded border border-void-700/50 group-hover:border-void-600 transition-colors">
            {{ entry.description }}
          </p>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{# ============= CONTACT ============= #}
<section class="container-wide section text-center relative">
  <div class="max-w-3xl mx-auto relative z-10">
    <p class="terminal-text mb-6 before:content-['<'] after:content-['>']">SECURE_CHANNEL</p>
    <h2 class="display-2 mb-6">{{ home.contact.title }}</h2>
    <p class="font-sans text-lg text-void-300 mb-12">
      {{ home.contact.description }}
    </p>

    <div class="grid sm:grid-cols-2 gap-6 max-w-2xl mx-auto mb-16 text-left">
      <div class="cyber-card p-6 flex items-start gap-4">
        <div class="h-10 w-10 bg-void-900 border border-cyber-500/30 flex items-center justify-center text-cyber-500 shrink-0 shadow-[inset_0_0_10px_rgba(0,196,212,0.1)]">
          <i class="fa-solid fa-terminal"></i>
        </div>
        <div>
          <p class="terminal-text !text-[10px] mb-1">PROTOCOL: EMAIL</p>
          <a href="mailto:{{ home.contact.email }}" class="font-mono text-sm text-void-50 hover:text-cyber-400 !border-none transition-colors">{{ home.contact.email }}</a>
        </div>
      </div>
      <div class="cyber-card p-6 flex items-start gap-4">
        <div class="h-10 w-10 bg-void-900 border border-cyber-500/30 flex items-center justify-center text-cyber-500 shrink-0 shadow-[inset_0_0_10px_rgba(0,196,212,0.1)]">
          <i class="fa-solid fa-location-crosshairs"></i>
        </div>
        <div>
          <p class="terminal-text !text-[10px] mb-1">COORDINATES</p>
          <p class="font-mono text-sm text-void-50">{{ home.contact.address }}</p>
          <p class="font-mono text-xs text-void-500 mt-1">UPTIME: {{ home.contact.workingHours }}</p>
        </div>
      </div>
    </div>
    
    <div class="w-full bg-void-900 overflow-hidden border border-void-600 relative group p-6">
      <div class="absolute inset-0 bg-[linear-gradient(rgba(0,196,212,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(0,196,212,0.03)_1px,transparent_1px)] bg-[size:20px_20px]"></div>
      
      <div class="relative z-10 aspect-[21/9] w-full flex items-center justify-center">
        <!-- Abstract Europe Map Outline Placeholder -->
        <svg class="absolute inset-0 w-full h-full opacity-20 text-cyber-500" viewBox="0 0 800 400" fill="none" stroke="currentColor" stroke-width="2">
          <!-- Simplified nodes/connections line -->
          <path d="M 450,250 L 350,150 L 500,300" stroke-dasharray="5,5" class="animate-[pulse_3s_ease-in-out_infinite]" />
        </svg>

        <!-- Berlin Node -->
        <div class="absolute left-[40%] md:left-[43%] top-[35%] md:top-[30%] flex flex-col items-center group/node">
          <span class="h-3 w-3 rounded-full bg-cyber-500 shadow-[0_0_15px_rgba(0,196,212,0.8)] relative">
            <span class="absolute inset-0 rounded-full bg-cyber-500 animate-ping opacity-50"></span>
          </span>
          <span class="font-mono text-[10px] text-cyber-400 mt-2 bg-void-900/80 px-1 py-0.5 rounded border border-cyber-500/30">BERLIN_SRH</span>
        </div>

        <!-- Macedonia Node -->
        <div class="absolute left-[50%] md:left-[52%] top-[65%] md:top-[60%] flex flex-col items-center group/node">
          <span class="h-2.5 w-2.5 rounded-full bg-void-50 border border-cyber-500 shadow-[0_0_8px_rgba(255,255,255,0.4)]"></span>
          <span class="font-mono text-[10px] text-void-400 mt-2 bg-void-900/80 px-1 py-0.5 rounded border border-void-700">UKIM_MKD</span>
        </div>

        <!-- Istanbul Node -->
        <div class="absolute left-[65%] md:left-[60%] top-[75%] md:top-[70%] flex flex-col items-center group/node">
          <span class="h-3 w-3 rounded-full bg-alert-500 shadow-[0_0_15px_rgba(255,51,102,0.8)] relative">
            <span class="absolute inset-0 rounded-full bg-alert-500 animate-ping opacity-50"></span>
          </span>
          <span class="font-mono text-[10px] text-alert-500 mt-2 bg-void-900/80 px-1 py-0.5 rounded border border-alert-500/30">IST_KHAS</span>
        </div>
      </div>

      <div class="relative z-10 mt-6 pt-4 border-t border-void-700 flex flex-col sm:flex-row justify-between items-center gap-2">
        <span class="terminal-text !text-cyber-500"><i class="fa-solid fa-satellite-dish mr-2 animate-pulse"></i> GLOBAL_NODE_NETWORK</span>
        <span class="font-mono text-xs text-void-300 bg-void-800 px-3 py-1.5 border border-void-600 rounded">
          > Active Node: <span class="text-alert-500 font-semibold">Istanbul</span> <span class="text-void-500 mx-2">||</span> Next: <span class="text-cyber-500">Berlin</span>
        </span>
      </div>
    </div>
  </div>
</section>
