<!DOCTYPE html>
<html lang="en" data-theme="dark" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} · {% endif %}{{ metadata.title }}</title>
  <meta name="description" content="{{ description or metadata.description }}">

  <meta name="google-site-verification" content="0b64d5c9758fafd9">

  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ metadata.url }}{{ page.url }}">
  <meta property="og:title" content="{% if title %}{{ title }} · {% endif %}{{ metadata.title }}">
  <meta property="og:description" content="{{ description or metadata.description }}">
  <meta property="og:site_name" content="{{ metadata.title }}">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{% if title %}{{ title }} · {% endif %}{{ metadata.title }}">
  <meta name="twitter:description" content="{{ description or metadata.description }}">

  <link rel="canonical" href="{{ metadata.url }}{{ page.url }}">

  <link rel="icon" type="image/svg+xml" href="/assets/icons/icon.svg">
  <link rel="manifest" href="/assets/icons/site.webmanifest">
  <meta name="theme-color" content="#090e1a">
  <link rel="alternate" href="/rss.xml" type="application/atom+xml" title="{{ metadata.title }} — Feed">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="min-h-screen flex flex-col bg-void-900 text-void-300 selection:bg-cyber-500 selection:text-void-900">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:bg-cyber-500 focus:text-void-900 focus:px-3 focus:py-2 focus:no-underline">Skip to content</a>

  <header id="site-header" class="border-b border-void-700 bg-void-900/90 backdrop-blur sticky top-0 z-40 transition-colors duration-300">
    <div class="container-wide">
      <div class="flex items-center justify-between gap-4 py-5">
        <a href="/" class="flex items-center gap-3 no-underline group">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded border border-cyber-500/30 bg-void-800 text-cyber-500 transition-all duration-300 group-hover:bg-cyber-500 group-hover:text-void-900 group-hover:shadow-[0_0_15px_rgba(0,196,212,0.4)]">
            <span class="font-display font-bold text-lg leading-none">MB</span>
          </span>
          <span class="font-display font-semibold text-xl text-void-50 tracking-tight group-hover:text-cyber-400 transition-colors duration-300">Mert Biricik</span>
        </a>

        <ul id="nav-menu" class="hidden md:flex items-center gap-8">
          {% for item in navigation %}
          <li>
            <a href="{{ item.url }}" class="terminal-text hover:text-cyber-300 transition-colors duration-300 {% if page.url == item.url %}text-void-50 drop-shadow-[0_0_8px_rgba(255,255,255,0.5)]{% endif %}">{{ item.text }}</a>
          </li>
          {% endfor %}
        </ul>

        <div class="flex items-center gap-3">
          <a href="{{ metadata.social.github }}" target="_blank" rel="noopener noreferrer" class="hidden sm:inline-flex h-9 w-9 items-center justify-center rounded text-void-400 hover:bg-void-800 hover:text-cyber-400 transition-colors duration-300" aria-label="GitHub">
            <i class="fa-brands fa-github text-lg"></i>
          </a>
          <button id="menu-toggle" class="md:hidden inline-flex h-9 w-9 items-center justify-center rounded text-void-400 hover:bg-void-800 hover:text-cyber-400 transition-colors duration-300" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
            <i class="fa-solid fa-bars text-lg"></i>
          </button>
        </div>
      </div>

      <div id="mobile-menu" class="md:hidden hidden border-t border-void-700 bg-void-900">
        <ul class="py-4 space-y-3">
          {% for item in navigation %}
          <li>
            <a href="{{ item.url }}" class="block terminal-text hover:text-cyber-400 {% if page.url == item.url %}text-void-50 drop-shadow-[0_0_8px_rgba(255,255,255,0.5)]{% endif %}">{{ item.text }}</a>
          </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </header>

  <main id="main" class="flex-1">
    {{ content | safe }}
  </main>

  <footer class="mt-auto border-t border-void-700 bg-void-800">
    <div class="container-wide py-16">
      <div class="grid gap-12 md:grid-cols-12">
        <div class="md:col-span-5">
          <p class="terminal-text mb-4">System Identity</p>
          <p class="font-sans text-base leading-relaxed text-void-300 max-w-md">
            Architected for scale and security. Engineered with Eleventy and Tailwind CSS. Rendered in <span class="font-display font-semibold text-void-50">Space Grotesk</span> and <span class="font-mono text-cyber-500">JetBrains Mono</span>.
          </p>
        </div>

        <div class="md:col-span-3">
          <p class="terminal-text mb-4">Comms Link</p>
          <ul class="space-y-3 font-mono text-sm text-void-400">
            <li><a href="{{ metadata.social.email }}" class="hover:text-cyber-400 transition-colors duration-300">mert@biricik.de</a></li>
            <li><a href="{{ metadata.social.linkedin }}" target="_blank" rel="noopener noreferrer" class="hover:text-cyber-400 transition-colors duration-300">LinkedIn</a></li>
            <li><a href="{{ metadata.social.github }}" target="_blank" rel="noopener noreferrer" class="hover:text-cyber-400 transition-colors duration-300">GitHub</a></li>
          </ul>
        </div>

        <div class="md:col-span-4">
          <p class="terminal-text mb-4">Index</p>
          <ul class="grid grid-cols-2 gap-y-3 font-mono text-sm text-void-400">
            {% for item in navigation %}
            <li><a href="{{ item.url }}" class="hover:text-cyber-400 transition-colors duration-300">{{ item.text }}</a></li>
            {% endfor %}
          </ul>
        </div>
      </div>

      <div class="mt-16 pt-8 border-t border-void-700 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs text-void-500 uppercase tracking-widest">
        <p>© {{ site.buildYear }} Mert Biricik.</p>
        <p>Operational status: Normal.</p>
      </div>
    </div>
  </footer>

  <script src="/js/main.js" defer></script>
</body>
</html>
