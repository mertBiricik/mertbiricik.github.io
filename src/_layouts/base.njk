<!DOCTYPE html>
<html lang="en">
<head>
  <script>
    (function() {
      try {
        var saved = localStorage.getItem('theme');
        var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = saved || (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
        if (theme === 'dark') document.documentElement.classList.add('dark');
      } catch (e) {}
    })();
  </script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} · {% endif %}{{ metadata.title }}</title>
  <meta name="description" content="{{ description or metadata.description }}">

  <meta name="google-site-verification" content="0b64d5c9758fafd9">

  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ metadata.url }}{{ page.url }}">
  <meta property="og:title" content="{% if title %}{{ title }} · {% endif %}{{ metadata.title }}">
  <meta property="og:description" content="{{ description or metadata.description }}">
  <meta property="og:site_name" content="{{ metadata.title }}">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{% if title %}{{ title }} · {% endif %}{{ metadata.title }}">
  <meta name="twitter:description" content="{{ description or metadata.description }}">

  <link rel="canonical" href="{{ metadata.url }}{{ page.url }}">

  <link rel="icon" type="image/svg+xml" href="/assets/icons/icon.svg">
  <link rel="manifest" href="/assets/icons/site.webmanifest">
  <meta name="theme-color" content="#f8fafc">
  <link rel="alternate" href="/rss.xml" type="application/atom+xml" title="{{ metadata.title }} — Feed">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="min-h-screen flex flex-col bg-slate-50 text-slate-800 dark:bg-slate-900 dark:text-slate-200">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:bg-slate-900 focus:text-slate-50 focus:px-3 focus:py-2 focus:no-underline">Skip to content</a>

  <header id="site-header" class="border-b border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/80 backdrop-blur sticky top-0 z-40 transition-colors duration-300">
    <div class="container-wide">
      <div class="flex items-center justify-between gap-4 py-6">
        <a href="/" class="flex items-center gap-3 no-underline group">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-slate-900 text-slate-50 dark:bg-slate-50 dark:text-slate-900 transition-transform duration-300 group-hover:scale-105">
            <span class="font-display font-semibold text-lg leading-none">MB</span>
          </span>
          <span class="font-display font-semibold text-xl text-slate-900 dark:text-slate-50 tracking-tight group-hover:text-sage-600 transition-colors duration-300">Mert Biricik</span>
        </a>

        <ul id="nav-menu" class="hidden md:flex items-center gap-8">
          {% for item in navigation %}
          <li>
            <a href="{{ item.url }}" class="text-sm font-medium tracking-wide text-slate-600 dark:text-slate-400 hover:text-sage-600 dark:hover:text-sage-400 transition-colors duration-300 {% if page.url == item.url %}text-slate-900 dark:text-slate-50{% endif %}">{{ item.text }}</a>
          </li>
          {% endfor %}
        </ul>

        <div class="flex items-center gap-3">
          <a href="{{ metadata.social.github }}" target="_blank" rel="noopener noreferrer" class="hidden sm:inline-flex h-9 w-9 items-center justify-center rounded-full text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors duration-300" aria-label="GitHub">
            <i class="fa-brands fa-github text-lg"></i>
          </a>
          <button id="theme-toggle" class="inline-flex h-9 w-9 items-center justify-center rounded-full text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors duration-300" aria-label="Toggle theme">
            <i class="fa-solid fa-sun sun-icon text-lg"></i>
            <i class="fa-solid fa-moon moon-icon text-lg"></i>
          </button>
          <button id="menu-toggle" class="md:hidden inline-flex h-9 w-9 items-center justify-center rounded-full text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors duration-300" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
            <i class="fa-solid fa-bars text-lg"></i>
          </button>
        </div>
      </div>

      <div id="mobile-menu" class="md:hidden hidden border-t border-slate-200 dark:border-slate-800">
        <ul class="py-4 space-y-3">
          {% for item in navigation %}
          <li>
            <a href="{{ item.url }}" class="block text-base font-medium text-slate-600 dark:text-slate-400 hover:text-sage-600 dark:hover:text-sage-400 {% if page.url == item.url %}text-slate-900 dark:text-slate-50{% endif %}">{{ item.text }}</a>
          </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </header>

  <main id="main" class="flex-1">
    {{ content | safe }}
  </main>

  <footer class="mt-auto border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900">
    <div class="container-wide py-16">
      <div class="grid gap-12 md:grid-cols-12">
        <div class="md:col-span-5">
          <p class="text-xs font-semibold uppercase tracking-widest text-sage-600 dark:text-sage-400 mb-4">About</p>
          <p class="font-sans text-base leading-relaxed text-slate-600 dark:text-slate-400 max-w-md text-justify">
            A premium, data-driven digital presence. Engineered with Eleventy, Tailwind CSS, and a strict JSON data architecture. Typography is set in <span class="font-display font-semibold">Playfair Display</span> and <span class="font-medium">Inter</span>.
          </p>
        </div>

        <div class="md:col-span-3">
          <p class="text-xs font-semibold uppercase tracking-widest text-slate-900 dark:text-slate-50 mb-4">Contact</p>
          <ul class="space-y-3 text-sm text-slate-600 dark:text-slate-400">
            <li><a href="{{ metadata.social.email }}" class="hover:text-sage-600 transition-colors duration-300">mert@biricik.de</a></li>
            <li><a href="{{ metadata.social.linkedin }}" target="_blank" rel="noopener noreferrer" class="hover:text-sage-600 transition-colors duration-300">LinkedIn</a></li>
            <li><a href="{{ metadata.social.github }}" target="_blank" rel="noopener noreferrer" class="hover:text-sage-600 transition-colors duration-300">GitHub</a></li>
          </ul>
        </div>

        <div class="md:col-span-4">
          <p class="text-xs font-semibold uppercase tracking-widest text-slate-900 dark:text-slate-50 mb-4">Navigation</p>
          <ul class="grid grid-cols-2 gap-y-3 text-sm text-slate-600 dark:text-slate-400">
            {% for item in navigation %}
            <li><a href="{{ item.url }}" class="hover:text-sage-600 transition-colors duration-300">{{ item.text }}</a></li>
            {% endfor %}
          </ul>
        </div>
      </div>

      <div class="mt-16 pt-8 border-t border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-slate-500">
        <p>© {{ site.buildYear }} Mert Biricik. All rights reserved.</p>
        <p>Deployed with precision.</p>
      </div>
    </div>
  </footer>

  <script src="/js/main.js" defer></script>
</body>
</html>
