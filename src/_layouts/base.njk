<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} · {% endif %}{{ metadata.title }}</title>
  <meta name="description" content="{{ description or metadata.description }}">

  <meta name="google-site-verification" content="0b64d5c9758fafd9">

  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ metadata.url }}{{ page.url }}">
  <meta property="og:title" content="{% if title %}{{ title }} · {% endif %}{{ metadata.title }}">
  <meta property="og:description" content="{{ description or metadata.description }}">
  <meta property="og:site_name" content="{{ metadata.title }}">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{% if title %}{{ title }} · {% endif %}{{ metadata.title }}">
  <meta name="twitter:description" content="{{ description or metadata.description }}">

  <link rel="canonical" href="{{ metadata.url }}{{ page.url }}">

  <link rel="icon" type="image/svg+xml" href="/assets/icons/icon.svg">
  <link rel="manifest" href="/assets/icons/site.webmanifest">
  <meta name="theme-color" content="#F5F5F3">
  <link rel="alternate" href="/rss.xml" type="application/atom+xml" title="{{ metadata.title }} — Feed">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Playfair+Display:ital,wght@0,600;0,700;0,900;1,600&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="min-h-screen flex flex-col bg-paper-100 text-ink-800 selection:bg-accent-500 selection:text-paper-50">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:bg-accent-500 focus:text-paper-50 focus:px-3 focus:py-2 focus:no-underline border-4 border-ink-900">Skip to content</a>

  <header id="site-header" class="border-b-4 border-ink-900 bg-paper-50 sticky top-0 z-40">
    <div class="container-wide">
      <div class="flex items-center justify-between gap-4 py-5">
        <a href="/" class="flex items-center gap-3 no-underline group">
          <span class="inline-flex h-10 w-10 items-center justify-center border-4 border-ink-900 bg-paper-50 text-ink-900 transition-all duration-200 group-hover:bg-accent-500 group-hover:text-paper-50 shadow-[4px_4px_0px_#0A0A0A]">
            <span class="font-display font-bold text-lg leading-none">MB</span>
          </span>
          <span class="font-display font-bold text-xl text-ink-900 tracking-tight transition-colors duration-200">Mert Biricik</span>
        </a>

        <ul id="nav-menu" class="hidden md:flex items-center gap-8">
          {% for item in navigation %}
          <li>
            <a href="{{ item.url }}" class="nav-link {% if page.url == item.url %}text-accent-500 font-bold{% endif %}">{{ item.text }}</a>
          </li>
          {% endfor %}
        </ul>

        <div class="flex items-center gap-3">
          <a href="{{ metadata.social.github }}" target="_blank" rel="noopener noreferrer" class="hidden sm:inline-flex h-9 w-9 items-center justify-center text-ink-800 hover:text-accent-500 transition-colors duration-200" aria-label="GitHub">
            <i class="fa-brands fa-github text-2xl"></i>
          </a>
          <button id="menu-toggle" class="md:hidden inline-flex h-9 w-9 items-center justify-center text-ink-800 hover:text-accent-500 transition-colors duration-200" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
            <i class="fa-solid fa-bars text-2xl"></i>
          </button>
        </div>
      </div>

      <div id="mobile-menu" class="md:hidden hidden border-t-4 border-ink-900 bg-paper-50">
        <ul class="py-4 space-y-3 px-6">
          {% for item in navigation %}
          <li>
            <a href="{{ item.url }}" class="block font-mono text-sm uppercase tracking-widest hover:text-accent-500 {% if page.url == item.url %}text-accent-500 font-bold{% else %}text-ink-800{% endif %}">{{ item.text }}</a>
          </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </header>

  <main id="main" class="flex-1">
    {{ content | safe }}
  </main>

  <footer class="mt-auto border-t-4 border-ink-900 bg-paper-200">
    <div class="container-wide py-16">
      <div class="grid gap-12 md:grid-cols-12">
        <div class="md:col-span-5">
          <p class="meta-label inline-block mb-4">Identity</p>
          <p class="font-sans text-base leading-relaxed text-ink-700 max-w-md">
            Built with strict brutalist principles. Engineered with Eleventy and Tailwind CSS. Rendered in <span class="font-display font-bold text-ink-900 italic">Playfair Display</span> and <span class="font-mono text-ink-900">JetBrains Mono</span>.
          </p>
        </div>

        <div class="md:col-span-3">
          <p class="meta-label inline-block mb-4">Channels</p>
          <ul class="space-y-3 font-mono text-sm text-ink-800">
            <li><a href="{{ metadata.social.email }}" class="hover:text-accent-500 transition-colors duration-200 underline decoration-2 underline-offset-4">mert@biricik.de</a></li>
            <li><a href="{{ metadata.social.linkedin }}" target="_blank" rel="noopener noreferrer" class="hover:text-accent-500 transition-colors duration-200 underline decoration-2 underline-offset-4">LinkedIn</a></li>
            <li><a href="{{ metadata.social.github }}" target="_blank" rel="noopener noreferrer" class="hover:text-accent-500 transition-colors duration-200 underline decoration-2 underline-offset-4">GitHub</a></li>
          </ul>
        </div>

        <div class="md:col-span-4">
          <p class="meta-label inline-block mb-4">Index</p>
          <ul class="grid grid-cols-2 gap-y-3 font-mono text-sm text-ink-800">
            {% for item in navigation %}
            <li><a href="{{ item.url }}" class="hover:text-accent-500 transition-colors duration-200 underline decoration-2 underline-offset-4">{{ item.text }}</a></li>
            {% endfor %}
          </ul>
        </div>
      </div>

      <div class="mt-16 pt-8 border-t-4 border-ink-900 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs text-ink-500 uppercase tracking-widest font-bold">
        <p>© {{ site.buildYear }} Mert Biricik.</p>
        <p>Aesthetics over everything.</p>
      </div>
    </div>
  </footer>

  <script src="/js/main.js" defer></script>
</body>
</html>
